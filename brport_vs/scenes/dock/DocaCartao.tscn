[gd_scene load_steps=4 format=3]

; Cartão de uma doca, na barra logo abaixo do mapa.
;
; Era uma chip flutuante ancorada no tabuado, e o playtest mostrou o problema:
; três chips escuras pousadas sobre os píeres tapavam justamente o barco, o
; guindaste e o trabalhador — a arte que diz o que está acontecendo. Agora o
; mapa fica limpo e o texto desce para uma fileira própria, alinhada, onde o
; polegar alcança os três alvos sem cobrir nada.

[ext_resource type="Script" path="res://scripts/DocaCartao.gd" id="1"]
[ext_resource type="Texture2D" path="res://art/icones/rival.svg" id="ic_rival"]
[ext_resource type="Texture2D" path="res://art/icones/trabalhador.svg" id="ic_trabalhador"]

