layout_mode = 0
offset_right = 720.0
offset_bottom = 720.0
mouse_filter = 2

; ORDEM = PROFUNDIDADE, aqui como em Dock.tscn: quem tem `mx+my` maior está
; mais perto da câmera e tapa quem tem menor. Os coqueiros estavam todos
; depois dos prédios e por isso apareciam por cima do armazém mesmo estando
; atrás dele; e o escritório, que é o mais distante dos dois, tapava o
; armazém. Intercalados por profundidade, cada um cai no seu lugar.
;
; Os três coqueiros também mudaram de sítio: estavam no meio do asfalto da
; rua nova. Agora ficam no passeio, entre a rua e as casas, que é onde um
; coqueiro fica numa cidade de porto.

