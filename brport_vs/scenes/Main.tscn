offset_bottom = 720.0
mouse_filter = 2
texture = ExtResource("3")

; A ESPUMA é camada, e não fundo. Ela fica ENTRE o mapa e o cenário: por cima
; da água, por baixo de tudo o que flutua nela. São duas, de sementes
; diferentes, e o `Main.gd` lava-as em contrafase — uma entra enquanto a outra
; sai. Uma só a pulsar punha a costa inteira a piscar ao mesmo tempo.

[node name="Espuma0" type="TextureRect" parent="MapaWrap"]
layout_mode = 0
offset_right = 720.0
offset_bottom = 720.0
mouse_filter = 2
