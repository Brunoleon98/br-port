[gd_scene load_steps=3 format=3]

; Um lugar da fila no fundeadouro — a linha «Ao largo» do HUD (`083`).
;
; Ocupa a coluna que era do cartão do trabalhador: desde a fila o trabalhador
; vai junto com o barco que se atraca, e o que fica por decidir é QUAL barco.
; O casco em miniatura vem por cima porque é o que separa um bote de um
; arrasteiro antes de o olho chegar ao valor. 70 px de altura desde a terceira
; passagem (eram 46 na primeira e 56 na segunda, a pedido do Bruno): o
; recorte já é justo ao desenho — a sombra de contacto soma 2 px ao quadro,
; medido —, logo o que crescia era só a altura. E desde a quarta os cascos
; estão TODOS NA MESMA ESCALA (o `Desenho` mede-se no `BarcoFila.gd`): a
; esticar cada um até aos 70, o bote saía do tamanho do longo curso, e o
; porte só se lia pelo nome.

[ext_resource type="Script" path="res://scripts/BarcoFila.gd" id="1"]
[ext_resource type="Texture2D" path="res://art/icones/rival.svg" id="ic_rival"]

[node name="BarcoFila" type="PanelContainer"]
custom_minimum_size = Vector2(224, 148)
theme_type_variation = &"CartaoDoca"
script = ExtResource("1")

[node name="Coluna" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 1
alignment = 1

[node name="Casco" type="CenterContainer" parent="Coluna"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
mouse_filter = 2

[node name="Desenho" type="TextureRect" parent="Coluna/Casco"]
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Cabecalho" type="HBoxContainer" parent="Coluna"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Nome" type="Label" parent="Coluna/Cabecalho"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_type_variation = &"TextoDocaNome"
theme_override_font_sizes/font_size = 14

[node name="Valor" type="Label" parent="Coluna/Cabecalho"]
layout_mode = 2
mouse_filter = 2
horizontal_alignment = 2
theme_type_variation = &"TextoDocaValor"
theme_override_font_sizes/font_size = 19

[node name="Carga" type="Label" parent="Coluna"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"TextoDocaProgresso"
theme_override_font_sizes/font_size = 13

[node name="EsperaLinha" type="HBoxContainer" parent="Coluna"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Icone" type="TextureRect" parent="Coluna/EsperaLinha"]
custom_minimum_size = Vector2(17, 17)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
visible = false
texture = ExtResource("ic_rival")
expand_mode = 1
stretch_mode = 5

[node name="Espera" type="Label" parent="Coluna/EsperaLinha"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"TextoDocaProgresso"
theme_override_font_sizes/font_size = 13
