[gd_scene load_steps=8 format=3]

; PROTÓTIPO VISUAL — não faz parte do jogo, não tem lógica.
;
; Duas coisas em teste:
;  1. Costa em DEGRAUS, para as docas descerem na vertical em vez de fugirem
;     para a esquerda (numa costa reta elas saem do ecrã retrato).
;  2. Os barcos rotacionados 26,6° — o ângulo do eixo do píer na tela. É um
;     paliativo: sprite ilustrado tem a perspetiva assada dentro dele, então
;     rodar só disfarça. O certo é GERAR já na orientação isométrica.

[ext_resource type="Texture2D" path="res://art/porto_mapa_iso.svg" id="1"]
[ext_resource type="Texture2D" path="res://art/sprites/cargueiro.png" id="2"]
