extends RefCounted

# Uma fonte para as duas portas da ajuda (`114`/`115`). Só lê as regras:
# abrir uma consulta não carrega save, sorteia, registra ou executa ações.
static func artigos(gs: Node) -> Array:
	var espacos: String = Narrativa.por_extenso(int(gs.ESPACOS))
	var cobrancas: String = Narrativa.por_extenso(int(gs.parcelas_na_fase(1)))
	var reputacao: String = String.num(float(gs.CANCELAMENTO_REPUTACAO), 2).trim_suffix(".0").replace(".", ",")
	var multa: String = String.num(float(gs.CANCELAMENTO_MULTA) * 100.0, 2).trim_suffix(".0").replace(".", ",")
	return [
		{"id": "atracar", "titulo": "Atracar e atender", "texto": "Os barcos esperam ao largo. Toque em um deles para atracar numa doca livre com trabalhador disponível. Veja a carga e o valor antes de escolher.\n\nAvançar o dia faz o serviço andar. O pagamento entra quando o atendimento termina. Alguns serviços precisam de mais de um dia. Os barcos ao largo têm paciência limitada; quem vai embora sem atendimento custa reputação."},
		{"id": "avancar", "titulo": "Avançar o dia", "texto": "O dia só muda quando você toca em Avançar dia. Você pode consultar o porto e seus painéis antes de decidir. A animação da virada acompanha essa ação.\n\nNa virada, os serviços e as obras progridem e o jogo calcula receitas, despesas e acontecimentos. Leia as decisões que aparecerem para continuar."},
		{"id": "dinheiro", "titulo": "Dinheiro e semana", "texto": "Toque no caixa para consultar as contas e a projeção do dia. O boletim da Dona Cida reúne o resultado da semana. Receita é o que entra; despesa é o que sai. Comprar uma obra usa dinheiro ao iniciar, e o benefício começa quando ela fica pronta.\n\nNa Fase 1, acompanhe as cobranças no calendário. Caixa negativo é avaliado no fechamento do dia; consulte a projeção antes de avançar."},
		{"id": "salvar", "titulo": "Salvar e retomar", "texto": "O jogo faz gravações automáticas durante a partida. Na pausa, Salvar e sair pede uma gravação e volta à tela inicial.\n\nNa tela inicial, Continuar abre a partida salva mais recente. Saves permite escolher entre os %s espaços. Nova partida pode substituir um espaço ocupado depois da confirmação.\n\nConfigurações reúne Ajustes, Como jogar e Versão e diagnóstico.\n\nAs partidas ficam neste aparelho ou navegador. Copiar registro da partida, nos Ajustes, copia os acontecimentos para análise; não é uma cópia do save para levar a outro aparelho." % espacos},
		{"id": "cancelar", "titulo": "Devolver ou cancelar", "texto": "Antes de operar o primeiro dia, toque na doca para devolver o barco ao largo. A devolução é gratuita e precisa de lugar na fila.\n\nDepois que o serviço começou, toque na doca para gerenciar. O cancelamento mostra os custos antes de confirmar: perde-se a receita inteira, sem pagamento parcial, há perda de %s pontos de reputação e multa de %s por cento do valor acordado, sem bônus, arredondada para cima.\n\nSe confirmar, o barco vai embora definitivamente. Doca e trabalhador ficam livres no mesmo dia. A multa pode deixar o caixa negativo; a verificação de derrota continua no fechamento. Isso cancela o serviço do barco, não uma obra." % [reputacao, multa]},
		{"id": "fases", "titulo": "Fases e metas", "texto": "Na Fase 1, quite as %s cobranças para seguir à Fase 2 na mesma partida. Na Fase 2, consulte o painel da meta: ele mostra os requisitos de reputação, infraestrutura e atendimento do primeiro cargueiro.\n\nNão há nova dívida nem prazo na Fase 2. Reputação baixa pode suspender novos cargueiros até se recuperar. Ao cumprir a meta, o diário fecha a fase e você pode continuar em jogo livre." % cobrancas},
		{"id": "glossario", "titulo": "Glossário", "texto": "Acordo\nValor combinado para atender aquele barco. A multa usa esse valor, sem os bônus de estruturas.\n\nAo largo / fundeadouro\nA fila de barcos que ainda aguardam uma doca.\n\nAtracar\nTrazer um barco da fila para uma doca com trabalhador disponível.\n\nBônus\nReceita adicional ligada às estruturas e à carga atendida.\n\nCaixa\nDinheiro disponível no porto.\n\nCargueiro\nClasse de barco liberada quando o porto alcança o nível necessário.\n\nDoca\nVaga onde o barco recebe atendimento.\n\nFechamento\nCálculo e acontecimentos da virada de dia ou de semana, conforme a conta.\n\nJogo livre\nContinuação da partida depois de cumprir a meta disponível.\n\nMulta\nDespesa cobrada ao confirmar o cancelamento de um serviço iniciado.\n\nPíer\nEstrutura do porto que oferece uma doca e sua equipe.\n\nReputação\nConfiança comercial do porto; influencia negociações e acesso a clientes.\n\nTreliça\nMelhoria do guindaste disponível na Fase 2, necessária para o porto receber cargueiros junto do píer adequado."},
	]
