; O balão de fala dos NPCs. As telas narrativas misturam dois registros — o que
; o jogo INFORMA (números, rótulos) e o que alguém DIZ — e sem uma diferença
; visual entre eles a fala da Dona Cida lê como mais uma linha de relatório.
; Creme com uma barra âmbar à esquerda: a barra é o que o olho lê como "aqui
; alguém está falando", sem precisar de itálico (que a fonte não tem).
[sub_resource type="StyleBoxFlat" id="fala"]
bg_color = Color(0.941, 0.965, 1, 1)
border_width_left = 3
border_color = Color(0.878, 0.604, 0.063, 1)
corner_radius_top_right = 8
corner_radius_bottom_right = 8
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 12.0
content_margin_bottom = 9.0

