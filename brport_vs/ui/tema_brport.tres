[sub_resource type="StyleBoxFlat" id="primario_normal"]
; O BOTÃO QUE MOVE O JOGO. A leitura da referência pede "cada botão com cor
; própria" numa barra de SEIS; esta interface tem DOIS, e com dois a distinção
; útil não é seis cores — é primário contra secundário. "Avançar dia" é o que
; faz o turno andar, e só ELE leva o âmbar cheio.
;
; ⚠️ MAS "ALOCAR TODOS" NÃO É CONVENIÊNCIA, e é isso que a segunda jogada no
; telefone desmentiu (06/09): "tem sido melhor para alocar os funcionários" —
; é por ali que o jogador aloca, e o botão estava desenhado como rodapé. Ele
; ganhou a variação `BotaoDestaque` abaixo: mesmo navy no fundo, BORDA e
; rótulo âmbar. Fundo âmbar nos dois seria duas em destaque, que é nenhuma em
; destaque; a borda dá corpo sem disputar. É a mesma regra que o cartão escuro
; já usava — sobre fundo escuro ganha-se corpo por borda, não por sombra.
;
; ⚠️ O TEXTO É NAVY, E ISSO FOI MEDIDO. Branco sobre este âmbar dá 2,39:1 de
; contraste — reprova até no corte de texto grande da WCAG (3,0). Navy sobre
; âmbar dá 5,27:1 e passa o AA normal. Botão âmbar com rótulo branco é o que
; sai quando se escolhe pelo aspecto e não se mede.
bg_color = Color(0.878, 0.604, 0.063, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
content_margin_left = 14.0
content_margin_top = 10.0
content_margin_right = 14.0
content_margin_bottom = 10.0
shadow_color = Color(0.44, 0.3, 0.03, 0.32)
shadow_size = 5
shadow_offset = Vector2(0, 3)

