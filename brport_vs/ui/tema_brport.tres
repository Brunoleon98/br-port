[gd_resource type="Theme" load_steps=16 format=3]

; BR Port VS — tema da interface
;
; Paleta portada do protótipo HTML validado (index.html, :root) — claro,
; navy sobre creme, cantos arredondados. Era o visual que o playtest
; considerou melhor que o placeholder escuro anterior.
;
; Este arquivo é o ponto único de estilo: mudar cor, canto ou fonte aqui
; muda a interface inteira, sem tocar em script nenhum. É o que torna o
; Bloco 4 (arte final) uma troca de recurso, e não uma reescrita de código.
;
;   navy   #1c3454   navy2  #24466e   amber  #e09a10
;   cream  #f0f6ff   white  #ffffff   border #d0dff0
;   green  #1a7a40   red    #c23030   warn   #d97706   gray #8299b4


