[gd_resource type="Theme" load_steps=26 format=3]

; BR Port VS — tema da interface
;
; Paleta portada do protótipo HTML validado (index.html, :root) — claro,
; navy sobre creme, cantos arredondados. Era o visual que o playtest
; considerou melhor que o placeholder escuro anterior.
;
; Este arquivo é o ponto único de estilo: mudar cor, canto ou fonte aqui
; muda a interface inteira, sem tocar em script nenhum. É o que torna o
; Bloco 4 (arte final) uma troca de recurso, e não uma reescrita de código.
;
;   navy   #1c3454   navy2  #24466e   amber  #e09a10
;   cream  #f0f6ff   white  #ffffff   border #d0dff0
;   green  #1a7a40   red    #c23030   warn   #d97706   gray #8299b4


[sub_resource type="StyleBoxFlat" id="cartao"]
; Etapa 6 do plano de arte, 02/09. A leitura da referência pede "borda clara de
; 2px e sombra PROJETADA por baixo". A sombra já existia, mas sem deslocamento:
; simétrica em volta do cartão, ela lê como halo e não como papel levantado da
; mesa. `shadow_offset` é o que a faz cair para baixo.
bg_color = Color(1, 1, 1, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.816, 0.875, 0.941, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
shadow_color = Color(0.11, 0.204, 0.329, 0.1)
shadow_size = 6
shadow_offset = Vector2(0, 3)

