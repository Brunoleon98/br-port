+def _semente_13a(identidade: str, canal: str) -> int:
+    chave = "BRP-13A-V4|%s|%s" % (identidade, canal)
+    return int.from_bytes(hashlib.sha256(chave.encode("utf-8")).digest()[:16], "big")
