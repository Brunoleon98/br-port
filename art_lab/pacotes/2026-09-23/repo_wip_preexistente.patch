+def arbusto_baixo_f1(mx: float, my: float, r: random.Random) -> str:
+    """Arbusto 13A: folhagem da frente da prancha V4, sem as árvores altas.
+
+    A prancha de vegetação V4 é referência de silhueta. O mapa desenha esta
+    peça no mesmo espaço das árvores: o SVG mantém a escala e a ordenação da
+    vila, sem um PNG grande para uma moita de poucos pixels na tela.
+    """
+    px, py = p(mx, my, ALT_CAIS)
+    s = ('  <ellipse cx="%.1f" cy="%.1f" rx="9.2" ry="2.7" '
+         'fill="%s" opacity="0.28"/>\n'
+         % (px + 2.3, py + 1.2, C["mangue"]))
+    # Dois ramos aparecem só junto ao chão. Traços mais finos sumiriam quando
+    # os 1080 px de desenho são vistos na largura de 720 do mapa.
+    s += traco([(px - 2.0, py - 1.0), (px - 6.0, py - 6.0)],
+               C["tronco"], 1.8)
+    s += traco([(px + 1.0, py - 0.8), (px + 6.8, py - 6.2)],
+               C["tronco"], 1.8)
+
+    # A referência tem um interior muito mais escuro que a V2. A pequena
+    # mancha de folhas secas fica atrás das verdes, visível mas localizada.
+    sombra = _misturar_cor(C["copa"], C["mangue"], 0.48)
+    fundo = _misturar_cor(C["copa"], C["mangue"], 0.70)
+    meio = _misturar_cor(C["copa"], C["copa_luz"], 0.32)
+    claro = _misturar_cor(C["copa"], C["copa_luz"], 0.74)
+    seco = _misturar_cor(C["solo_claro"], "#c2a343", 0.68)
+    s += poli([(px - 11.3, py - 5.0), (px - 7.5, py - 9.3),
+               (px + 5.5, py - 8.4), (px + 11.3, py - 3.8),
+               (px + 7.8, py + 0.4), (px - 7.7, py + 0.3)], fundo)
+
+    # Primeiro os volumes de trás, depois os mais claros e largos da frente.
+    # A altura assimétrica evita uma barra de copas idênticas em miniatura.
+    for dx, dy, rx, ry, altura, cor in (
+            (-8.0, -8.0, 5.5, 3.8, 4.1, sombra),
+            (-0.7, -13.0, 6.2, 4.8, 5.2, meio),
+            (6.7, -10.4, 6.9, 4.6, 5.2, C["copa"]),
+            (-5.2, -6.3, 6.8, 4.2, 4.5, claro),
+            (4.6, -5.7, 7.5, 4.7, 4.7, meio),
+            (-10.2, -3.2, 4.2, 2.9, 3.0, fundo),
+            (10.2, -2.8, 4.3, 3.0, 3.1, sombra)):
+        s += com_saia(_lobo(px + dx, py + dy, rx, ry, r), altura, cor)
+
+    # Um tufo seco espreita pelo lado esquerdo, como no conceito. Desenhá-lo
+    # atrás de todas as copas fazia o detalhe desaparecer inteiro a 1:1.
+    s += poli([(px - 11.6, py - 8.2), (px - 10.3, py - 10.8),
+               (px - 8.5, py - 8.5), (px - 6.6, py - 10.6),
+               (px - 5.7, py - 5.7), (px - 9.1, py - 4.6)], seco)
+    s += poli([(px - 9.1, py - 4.6), (px - 5.7, py - 5.7),
+               (px - 6.2, py - 2.4), (px - 9.3, py - 2.3)],
+              _sombrear(seco, 0.68))
+
+    # Três manchas de folhas grandes. Cada uma mede mais de dois pixels na
+    # tela; nervuras, folhas soltas e textura miúda desapareceriam a 1:1.
+    s += poli([(px - 3.9, py - 14.6), (px - 0.9, py - 16.1),
+               (px + 2.0, py - 14.6), (px - 0.7, py - 12.1)], claro)
+    s += poli([(px + 5.0, py - 10.9), (px + 8.7, py - 12.0),
+               (px + 10.4, py - 9.4), (px + 6.8, py - 8.4)],
+              _misturar_cor(meio, C["copa_luz"], 0.30))
+    s += poli([(px + 0.8, py - 6.1), (px + 3.6, py - 8.4),
+               (px + 7.1, py - 7.1), (px + 5.3, py - 4.9)],
+              _misturar_cor(meio, claro, 0.44))
+    s += poli([(px - 8.5, py - 8.1), (px - 5.6, py - 8.8),
+               (px - 3.2, py - 6.6), (px - 6.4, py - 5.4)],
+              _misturar_cor(claro, C["solo_claro"], 0.22))
+    return s
+
+
 def vegetacao_do_solo(indice: int, mx0: float, my0: float, mx1: float,
