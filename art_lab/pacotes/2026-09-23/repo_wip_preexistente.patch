     """Povoa o solo atrás da rua: mata fechada no fundo, moita e capim à frente.
@@ -1128,6 +1194,16 @@ def vegetacao_do_solo(indice: int, mx0: float, my0: float, mx1: float,
         else:
             gx, gy = p(mx, my, ALT_CAIS)
             s += tufo_de_capim(gx, gy, r)
+
+    # Primeira prova da 13A na faixa natural atrás da segunda fileira. Uma
+    # semente própria preserva os sorteios anteriores (árvores, moitas e capim).
+    # Não há arbusto sobre a rua, acessos, píeres nem nos degraus fora da tela.
+    posicoes = {1: (2.5, 5.0, 6.6), 2: (10.2, 12.0)}
+    ar = random.Random(SEMENTE_CHAO + 1300 + indice)
+    for my in posicoes.get(indice, ()):
+        mx = mx1 - 0.48 - ar.uniform(0.0, 0.26)
+        if no_quadro(mx, my):
+            s += arbusto_baixo_f1(mx, my, ar)
     return s
 
 
